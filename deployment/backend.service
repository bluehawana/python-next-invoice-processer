[Unit]
Description=Invoice Processor Backend
After=network.target

[Service]
User=harvad
WorkingDirectory=/home/harvad/invoice-processor/backend
ExecStart=/home/harvad/invoice-processor/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
EnvironmentFile=/home/harvad/invoice-processor/backend/.env

[Install]
WantedBy=multi-user.target
